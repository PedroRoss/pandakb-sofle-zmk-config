#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define SYMBOLS_BASE 1
#define RUCHEY 2
#define SYMBOLS_RUCHEY 3
#define EDITING 4
#define ADJUST 5

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <SYMBOLS_BASE EDITING>;
            then-layer = <ADJUST>;
        };
        adjust_layer_legacy {
            if-layers = <SYMBOLS_RUCHEY EDITING>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp EXCL  &kp AT     &kp HASH  &kp DLLR  &kp PRCNT              &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp K_CMENU
&kp TAB   &kp SQT   &kp COMMA  &kp DOT   &kp P     &kp Y                  &kp F      &kp G     &kp C     &kp R     &kp L     &kp FSLH
&kp CLCK  &kp A     &kp O      &kp E     &kp U     &kp I                  &kp D      &kp H     &kp T     &kp N     &kp S     &kp MINUS
&kp LGUI  &kp SEMI  &kp Q      &kp J     &kp K     &kp X   &none &none    &kp B      &kp M     &kp W     &kp V     &kp Z     &kp EQUAL
        &kp LSHFT   &kp LCTRL   &kp LALT   &to 1   &kp SPACE &kp RET    &to 4   &kp BSPC   &kp DEL   &kp INS
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT K_VOLUME_DOWN &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        symbols_base_layer {
            display-name = "Symbols";
            bindings = <
&kp ESC   &kp F1    &kp F2     &kp F3     &kp F4     &kp F5                 &kp F6      &kp F7     &kp F8    &kp F9    &kp F10    &kp F11
&kp TAB   &kp LT    &kp GT     &kp LBKT   &kp RBKT   &kp BSLH               &none       &kp HOME   &kp UP    &kp END   &kp PG_UP  &kp F12
&kp CLCK  &kp LC(Z) &kp LC(P)  &kp LC(H)  &kp LC(F)  &none                  &none       &kp LEFT   &kp DOWN  &kp RIGHT &kp PG_DN  &kp K_CMENU
&kp LGUI  &none     &kp LC(X)  &kp LC(C)  &kp LC(V)  &none    &none &none   &kp PSCRN   &none      &none     &none     &none      &none
                       &kp LSHFT   &kp LCTRL   &kp LALT   &none   &kp SPACE &kp RET    &to 0   &kp BSPC   &kp DEL   &kp INS
            >;
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT K_VOLUME_DOWN &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        ruchey_layer {
            display-name = "Ruchey";
             bindings = <
&kp ESC   &none    &none     &none     &none   &none                 &none  &kp KP_NUMLOCK &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS  &kp K_CMENU
&kp TAB   &kp P    &kp A     &kp O     &kp T   &kp MINUS             &none  &kp N7         &kp N8        &kp N9          &kp KP_PLUS   &none
&kp CLCK  &kp S    &kp A     &kp P     &kp B   &kp A                 &none  &kp N4         &kp N5        &kp N6          &kp KP_COMMA  &none
&kp LGUI  &none    &kp I     &kp O     &none   &none   &none &none   &kp N0 &kp N1         &kp N2        &kp N3          &kp KP_EQUAL  &kp KP_DOT
         &kp LSHFT   &kp LCTRL   &kp LALT   &to 0   &kp SPACE &kp RET    &none   &kp BSPC   &kp DEL   &kp INS
            >;
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT K_VOLUME_DOWN &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        symbols_ruchey_layer {
            display-name = "Symbols*";
            bindings = <
&none &none &none  &none  &none  &none               &none &none &none &none &none &none
&none &none &none  &none  &none  &none               &none &none &none &none &none &none
&none &none &none  &none  &none  &none               &none &none &none &none &none &none
&none &none &none  &none  &none  &none  &none  &none &none &none &none &none &none &none
                 &none &none &none &none &none   &none &none &none &none &none
            >;
         //  sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN &inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        editing_layer {
            display-name = "Editing";
            bindings = <
&kp ESC   &none    &none     &none     &none   &none                 &none  &kp KP_NUMLOCK &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS  &kp K_CMENU
&kp TAB   &kp P    &kp A     &kp O     &kp T   &kp MINUS             &none  &kp N7         &kp N8        &kp N9          &kp KP_PLUS   &none
&kp CLCK  &kp S    &kp A     &kp P     &kp B   &kp A                 &none  &kp N4         &kp N5        &kp N6          &kp KP_COMMA  &none
&kp LGUI  &none    &kp I     &kp O     &none   &none   &none &none   &kp N0 &kp N1         &kp N2        &kp N3          &kp KP_EQUAL  &kp KP_DOT
         &kp LSHFT   &kp LCTRL   &kp LALT   &to 0   &kp SPACE &kp RET    &none   &kp BSPC   &kp DEL   &kp INS
            >;
            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT K_VOLUME_DOWN &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &none              &none &none &none &none &none &none
&ext_power EP_TOG &none        &none        &none        &none &none              &none &none &none &none &none &none
&none             &none        &none        &none        &none &none              &none &none &none &none &none &none
&none             &none        &none        &none        &none &none &none &none  &none &none &none &none &none &none
        &kp LSHFT   &kp LCTRL   &kp LALT   &tog 0   &kp SPACE &kp RET    &tog 0   &kp BSPC   &kp DEL   &kp INS
            >;
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };
    };
};
